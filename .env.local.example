# Supabase (get from supabase.com → project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# eBay Developer API (developer.ebay.com → My Account → Application Keys → Production)
# App ID = EBAY_CLIENT_ID, Cert ID = EBAY_CLIENT_SECRET
EBAY_CLIENT_ID=your-app-id
EBAY_CLIENT_SECRET=your-cert-id
EBAY_ENVIRONMENT=production

# eBay Marketplace Account Deletion endpoint (required to enable production keyset)
# Generate token: openssl rand -hex 32
# Endpoint URL: https://<your-domain>/api/ebay/account-deletion
EBAY_DELETION_VERIFICATION_TOKEN=your-random-hex-token
EBAY_DELETION_ENDPOINT_URL=https://your-domain.vercel.app/api/ebay/account-deletion

# RapidAPI — sold comps fallback (ebay-average-selling-price on rapidapi.com)
RAPIDAPI_KEY=your-rapidapi-key

# OpenWebNinja — live listing search fallback (openwebninja.com)
OPENWEBNINJA_API_KEY=your-openwebninja-key

# Anthropic Claude (AI grading vision pipeline — anthropic.com/api)
ANTHROPIC_API_KEY=your-anthropic-key

# Resend (email notifications — resend.com)
RESEND_API_KEY=re_your-api-key

# Inngest (background jobs — inngest.com → event key + signing key)
INNGEST_EVENT_KEY=your-event-key
INNGEST_SIGNING_KEY=your-signing-key

# Web Push VAPID keys (generate: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# PSA Grading Costs (update when PSA changes pricing)
PSA_REGULAR_FEE=25
PSA_EXPRESS_FEE=150
PSA_SUPER_EXPRESS_FEE=500
PSA_SHIPPING_COST=12
PSA_REGULAR_DAYS=45
PSA_EXPRESS_DAYS=5
PSA_SUPER_EXPRESS_DAYS=2

# CV Microservice (local Python centering service — not needed for cloud deployment)
CV_SERVICE_URL=http://localhost:8001
